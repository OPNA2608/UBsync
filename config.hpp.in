#pragma once

#include <QDir>
#include <QString>

static const QString APP_DIR = qgetenv ("APP_DIR");

static const QString OWNCLOUD_VENDOR_LIBDIR = QStringLiteral ("@CLICK_LIB_PATH@");
static const QString OWNCLOUD_VENDOR_BINDIR = QStringLiteral ("@CLICK_BIN_PATH@");

inline bool isClick (void)
{
    static bool appDirSet = !APP_DIR.isEmpty();
    return appDirSet;
}

inline QString vendoredOwncloudLibdir (void)
{
    static QString dir = QString();

    if (dir.isEmpty())
    {
        if (!APP_DIR.isEmpty())
        {
            dir = QDir::cleanPath (APP_DIR + QStringLiteral ("/") + OWNCLOUD_VENDOR_LIBDIR);
        }
    }

    return dir;
}

inline QString vendoredOwncloudBindir (void)
{
    static QString dir = QString();

    if (dir.isEmpty())
    {
        if (!APP_DIR.isEmpty())
        {
            dir = QDir::cleanPath (APP_DIR + QStringLiteral ("/") + OWNCLOUD_VENDOR_BINDIR);
        }
    }

    return dir;
}

inline QString cloudCmd (QString cmd)
{
    if (!APP_DIR.isEmpty())
    {
        return QDir::cleanPath (vendoredOwncloudBindir() + QStringLiteral ("/") + cmd);
    }
    else
    {
        return cmd;
    }
}
