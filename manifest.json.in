{
    "name": "lomiri-cloudsync-app",
    "description": "A tool to synchronise files between Ubuntu Touch and your ownCloud/nextCloud server",
    "architecture": "@CLICK_ARCH@",
    "title": "Cloudsync",
    "hooks": {
        "Cloudsync": {
            "accounts": "Cloudsync-ui/lomiri-cloudsync-app.accounts",
            "apparmor": "Cloudsync-ui/lomiri-cloudsync-app.apparmor",
            "desktop": "Cloudsync-ui/lomiri-cloudsync-app.desktop"
        }
    },
    "version": "0.8.1",
    "maintainer": "Jan Belohoubek <jan.belohoubek@fit.cvut.cz>",
    "framework": "ubuntu-sdk-20.04"
}
